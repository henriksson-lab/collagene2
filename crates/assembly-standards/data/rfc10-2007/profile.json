  "id": "biobrick-rfc10-part-sequence-2007",
  "revision": "knight-2007-05-03-oww-297083-curation-1",
  "name": "BioBrick RFC10 part-sequence format (2007)",
  "scope": "Required and advisory part-body/prefix/suffix sequence constraints of Knight RFC10 (3 May 2007), sections 1–3. Ordered part roles are declarations; no biological functional order is imposed.",
  "limitations": [
    "This is not full RFC10 vector, sequencing-primer, host or registry-submission compliance.",
    "No cleavage, ligation, experimental success, protein expression or functional compatibility is established.",
    "Inputs are oriented formatted linear parts with explicit body boundaries. Whole-vector coordinates and circular origins are not inferred.",
    "The standard permits both declared part types in any order; overhang equality is a documentary grammar fact, not validated physical termini.",
    "Recommended internal sites and in-frame TAATAA termination are advisory; mandatory NotI absence follows this exact 2007 draft, not a newer four-site summary."
  ],
  "curation_license": "MIT (independently authored factual selection; upstream standard prose is not copied)",
